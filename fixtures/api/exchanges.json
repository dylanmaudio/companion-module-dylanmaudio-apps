    {
      "id": "security.origin",
      "request": {"method": "POST", "path": "/api/v1/hello",
        "headers": {"Origin": "https://some-website.example"},
        "content_type": "text/plain;charset=UTF-8",
        "body": {"v": 1, "session": "main", "name": "web page", "kind": "companion"}},
      "response": {"status": 403, "body": {
        "ok": false, "error": {"code": "forbidden_origin"}}},
      "note": "#105, spec §4: a web page's cross-site POST. text/plain needs no CORS preflight; it got a lane until MIDI Bridge 1.3.1."
    },
    {
      "id": "security.origin.cmd",
      "request": {"method": "POST", "path": "/api/v1/cmd",
        "headers": {"Origin": "https://some-website.example"},
        "body": {"lane_id": "<lane>", "cid": "fx9", "intent": {"op": "raw", "hex": "9b 00 7f"}}},
      "response": {"status": 403, "body": {
        "ok": false, "error": {"code": "forbidden_origin"}}},
      "sends": [],
      "note": "#105: Input 1 mute on reached the console from a web page until MIDI Bridge 1.3.1."
    },
    {
      "id": "security.host",
      "request": {"method": "GET", "path": "/api/v1/info",
        "headers": {"Host": "attacker.example"}},
      "response": {"status": 403, "body": {
        "ok": false, "error": {"code": "forbidden_host"}}},
      "note": "DNS rebinding: a hostname that resolves to 127.0.0.1 must still be refused."
    },
    {
      "id": "cmd.bad_content_type",
      "request": {"method": "POST", "path": "/api/v1/cmd",
        "content_type": "text/plain",
        "body": {"lane_id": "<lane>", "cid": "fx10", "intent": {"op": "raw", "hex": "9b 00 7f"}}},
      "response": {"status": 415, "body": {
        "ok": false, "error": {"code": "bad_content_type"}}},
      "sends": [],
      "note": "A cross-site page can send text/plain without a preflight; application/json it cannot."
    },
    {
      "id": "hello.digico",
      "family": "digico", "codec": true, "model": "SD11",
      "request": {"method": "POST", "path": "/api/v1/hello",
        "body": {"v": 1, "session": "main", "name": "Fixture SD Lane", "kind": "app", "consoles": ["digico"]}},
      "response": {"status": 200, "body": {
        "lane_id": "<str>", "capabilities": {"unavailable_retry": true}}},
      "note": "#318: capabilities.unavailable_retry says a desk-state refusal that clears by itself answers 503 <op>_unavailable, not 400 desk_state. Pilot Tone's SD failover requires it."
    },
    {
      "id": "cmd.scene_number.list_unread",
      "family": "digico", "codec": true, "model": "SD11",
      "request": {"method": "POST", "path": "/api/v1/cmd",
        "body": {"lane_id": "<lane>", "cid": "fx-sd1", "intent": {"op": "scene", "scene_number": 2}}},
      "response": {"status": 503, "body": {
        "ok": false, "error": {"code": "scene_unavailable"}}},
      "sends": [],
      "note": "#318: a recall by the number on screen before the SD's snapshot list is read (or in the 0.5 s after a snapshot is inserted or deleted at the desk) is 503 scene_unavailable: it clears by itself, so a client holds it and tries again; it is no lost link. A number no snapshot has, or two have, stays 400 desk_state."
    },
    {
      "id": "cmd.scene_name.mismatch",
      "family": "digico", "codec": true, "model": "SD11",
      "desk": [{"kind": "scene_name", "scene": 1, "number": 1.0, "name": "BASE"}, {"kind": "scene_count", "count": 1}],
      "request": {"method": "POST", "path": "/api/v1/cmd",
        "body": {"lane_id": "<lane>", "cid": "fx-sd2", "intent": {"op": "scene", "scene_number": 1, "scene_name": "VERSE"}}},
      "response": {"status": 400, "body": {
        "ok": false, "error": {"code": "desk_state"}}},
      "sends": [],
      "note": "scenes.name_pin: a recall by number pinned to the name it had when the button was made. The scene at that number is named otherwise, so nothing is recalled, and the message names what it's called now. 400, not 503: it stands until the show changes back."
    },
    {
      "id": "state.scene.current.digico",
      "family": "digico", "codec": true, "model": "SD11",
      "desk": [{"kind": "scene_name", "scene": 2, "number": 1.5, "name": "VERSE"}, {"kind": "scene_name", "scene": 1, "number": 1.0, "name": "BASE"}, {"kind": "scene_count", "count": 2}, {"kind": "scene", "scene": 2}],
      "request": {"method": "GET", "path": "/api/v1/state"},
      "response": {"status": 200, "body": {"state": {"scene.current": {"number": 2, "name": "VERSE", "scene_number": 1.5}}}},
      "note": "scene.current carries what the desk's scene event carries: scene_number on a by_number desk, and scene_list (a field this desk doesn't have) on a desk with scenes.lists."
    },
    {"id": "hello.digico.sd11", "family": "digico", "codec": true, "model": "SD11", "request": {"method": "POST", "path": "/api/v1/hello", "body": {"v": 1, "session": "main", "name": "Fixture SD Lane", "kind": "app", "consoles": ["digico"]}}, "response": {"status": 200, "body": {"lane_id": "<str>", "capabilities": {"fader_db": true}}}, "note": "Per-model verification (27 Oct): the SD11 is the model the SD driver was checked on, so fader_db holds."},
    {"id": "info.console.digico.desk_params", "family": "digico", "codec": true, "model": "SD11", "request": {"method": "GET", "path": "/api/v1/info"}, "response": {"status": 200, "body": {"console": {"model": "SD11", "verified_on_desk": true, "pan": {"types": ["input"], "step": null, "pushed": true}, "filters": {"hpf": {"types": ["input"], "freq_hz": [20, 20000]}}, "eq": {"types": ["input"], "pushed": true}}}}, "note": "#243: the block declares what each desk parameter takes, only as written and read on a desk; `model` is the desk's identity."},
    {"id": "cmd.pan.sd", "family": "digico", "codec": true, "model": "SD11", "request": {"method": "POST", "path": "/api/v1/cmd", "body": {"lane_id": "<lane>", "cid": "fx-sd2", "intent": {"op": "pan", "type": "input", "index": 8, "pan": -0.5}}}, "response": {"status": 200, "body": {"ok": true}}, "sends": ["2f 49 6e 70 75 74 5f 43 68 61 6e 6e 65 6c 73 2f 38 2f 50 61 6e 6e 65 72 2f 70 61 6e 00 00 00 00 2c 66 00 00 3e 80 00 00"], "note": "#243: pan −1…+1 (centre 0); the SD's wire is 0…1, so −0.5 is 0.25."},
    {"id": "cmd.peq.sd", "family": "digico", "codec": true, "model": "SD11", "request": {"method": "POST", "path": "/api/v1/cmd", "body": {"lane_id": "<lane>", "cid": "fx-sd3", "intent": {"op": "peq", "type": "input", "index": 8, "band": "1", "gain": 6.0}}}, "response": {"status": 200, "body": {"ok": true}}, "sends": ["2f 49 6e 70 75 74 5f 43 68 61 6e 6e 65 6c 73 2f 38 2f 45 51 2f 65 71 5f 67 61 69 6e 5f 31 00 00 2c 66 00 00 40 c0 00 00"], "note": "#243: one EQ band; band ids are strings and stable."},
    {"id": "cmd.peq.out_of_range", "family": "digico", "codec": true, "model": "SD11", "request": {"method": "POST", "path": "/api/v1/cmd", "body": {"lane_id": "<lane>", "cid": "fx-sd4", "intent": {"op": "peq", "type": "input", "index": 8, "band": "1", "gain": 24.0}}}, "response": {"status": 400, "body": {"ok": false, "error": {"code": "bad_intent"}}}, "sends": [], "note": "#243: outside the declared range (the SD's ±18 dB) is refused, never clamped (the SD drops it silently)."},
    {"id": "cmd.peq.no_band", "family": "digico", "codec": true, "model": "SD11", "request": {"method": "POST", "path": "/api/v1/cmd", "body": {"lane_id": "<lane>", "cid": "fx-sd5", "intent": {"op": "peq", "type": "input", "index": 8, "gain": 3.0}}}, "response": {"status": 400, "body": {"ok": false, "error": {"code": "bad_intent"}}}, "sends": [], "note": "#243: peq takes a band; the whole EQ is `eq`."},
    {"id": "cmd.pan.unsupported_type", "family": "digico", "codec": true, "model": "SD11", "request": {"method": "POST", "path": "/api/v1/cmd", "body": {"lane_id": "<lane>", "cid": "fx-sd6", "intent": {"op": "pan", "type": "aux", "index": 1, "pan": 0.0}}}, "response": {"status": 400, "body": {"ok": false, "error": {"code": "unsupported_op"}}}, "sends": [], "note": "#243: a strip type not yet written on a desk (the SD's buses) is unsupported_op."},
    {"id": "cmd.query.pan.sd", "family": "digico", "codec": true, "model": "SD11", "request": {"method": "POST", "path": "/api/v1/cmd", "body": {"lane_id": "<lane>", "cid": "fx-sd7", "intent": {"op": "query", "type": "input", "index": 8, "fields": ["pan"]}}}, "response": {"status": 200, "body": {"ok": true, "pending": true}}, "note": "#243: these aren't in the cold sync; a query reads them, the answers as deltas."},
    {"id": "cmd.alt.unsupported", "family": "digico", "codec": true, "model": "SD11", "request": {"method": "POST", "path": "/api/v1/cmd", "body": {"lane_id": "<lane>", "cid": "fx-sd-alt1", "intent": {"op": "alt", "type": "input", "index": 1, "on": true}}}, "response": {"status": 400, "body": {"ok": false, "error": {"code": "unsupported_op"}}}, "sends": [], "note": "#304: a strip's main/alt input, only where the block claims `alt` and declares it (the Wing first); the SD's isn't measured yet."},
    {"id": "cmd.query.alt.unsupported", "family": "digico", "codec": true, "model": "SD11", "request": {"method": "POST", "path": "/api/v1/cmd", "body": {"lane_id": "<lane>", "cid": "fx-sd-alt2", "intent": {"op": "query", "type": "input", "index": 1, "fields": ["alt"]}}}, "response": {"status": 400, "body": {"ok": false, "error": {"code": "unsupported_op"}}}, "sends": [], "note": "#304: `query` field `alt` reads the switch and the alt source where the block claims `alt`."},
    {"id": "hello.digico.sd12", "family": "digico", "codec": true, "model": "SD12", "request": {"method": "POST", "path": "/api/v1/hello", "body": {"v": 1, "session": "main", "name": "Fixture SD Lane", "kind": "app", "consoles": ["digico"]}}, "response": {"status": 200, "body": {"lane_id": "<str>", "capabilities": {"fader_db": false}}}, "note": "Per-model verification: a model the driver wasn't checked on has no fader_db."},
    {"id": "cmd.mute.desk_unverified", "family": "digico", "codec": true, "model": "SD12", "request": {"method": "POST", "path": "/api/v1/cmd", "body": {"lane_id": "<lane>", "cid": "fx-sd8", "intent": {"op": "mute", "type": "input", "index": 1, "on": true}}}, "response": {"status": 400, "body": {"ok": false, "error": {"code": "desk_unverified"}}}, "sends": [], "note": "Per-model verification: in a release build an unverified model's writes are refused, naming the desk; a test build lets them through."},
    {"id": "hello.digico.unidentified", "family": "digico", "codec": true, "request": {"method": "POST", "path": "/api/v1/hello", "body": {"v": 1, "session": "main", "name": "Fixture SD Lane", "kind": "app", "consoles": ["digico"]}}, "response": {"status": 200, "body": {"lane_id": "<str>"}}, "note": "A desk that hasn't said which model it is yet."},
    {"id": "cmd.mute.model_unavailable", "family": "digico", "codec": true, "request": {"method": "POST", "path": "/api/v1/cmd", "body": {"lane_id": "<lane>", "cid": "fx-sd9", "intent": {"op": "mute", "type": "input", "index": 1, "on": true}}}, "response": {"status": 503, "body": {"ok": false, "error": {"code": "model_unavailable"}}}, "sends": [], "note": "Before the desk has said its model: 503, which a client retries."},
