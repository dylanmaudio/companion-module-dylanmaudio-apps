{
	"name": "dylanmaudio-apps",
	"version": "1.1.93",
	"description": "Companion module for the dylanmaudio apps: dLive MIDI Bridge, Talk Light Trigger, Pilot Tone Trigger, Time Code Tool and Console Control",
	"main": "dist/main.js",
	"type": "module",
	"license": "MIT",
	"author": "Dylan Mitrovich (dylanmaudio)",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bitfocus/companion-module-dylanmaudio-apps.git"
	},
	"scripts": {
		"format": "prettier -w .",
		"package": "run build && companion-module-build",
		"build": "rimraf dist && run build:main",
		"build:main": "tsc -p tsconfig.build.json",
		"dev": "tsc -p tsconfig.build.json --watch",
		"lint:raw": "eslint",
		"lint": "run lint:raw .",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"engines": {
		"node": "^22.20 || ^26.5",
		"yarn": "^4"
	},
	"dependencies": {
		"@companion-module/base": "~2.1.3"
	},
	"devDependencies": {
		"@companion-module/tools": "^3.1.0",
		"@types/node": "^22.19.17",
		"eslint": "^10.2.0",
		"prettier": "^3.8.3",
		"rimraf": "^6.1.3",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.59.0",
		"vitest": "^4.1.11"
	},
	"prettier": "@companion-module/tools/.prettierrc.json",
	"packageManager": "yarn@4.17.0"
}
